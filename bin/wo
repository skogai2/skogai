#!/usr/bin/env bash
# wo — workorder pipeline: wt owns worktrees, herdr owns panes/agents.
#
#   wo new <slug>          create .skogai/workorders/NNNN-<slug>.md from the template
#   wo dispatch <id>       commit the workorder, create worktree(s), open herdr tab, start + prompt worker
#   wo status              workorders, their worker agents and worktrees
#   wo land <id>           merge a done workorder (and its target repo branch), close its tab, remove worktrees
#
# <id> is the 4-digit number or the full NNNN-slug stem.
# `repo: <gita name>` in a workorder targets another repo: the worker runs in a worktree of that
# repo (same branch name) and writes its report into the skogai worktree, which it gets via --add-dir.
# Env: WO_KIND (default claude), WO_ARGS (native agent args; default per kind).
set -euo pipefail

ROOT=$(git -C "$(dirname "$0")/.." rev-parse --show-toplevel)
WO_DIR="$ROOT/.skogai/workorders"
WORKERS_LABEL=workers
KIND=${WO_KIND:-claude}

die() { echo "wo: $*" >&2; exit 1; }

# Workers run in auto mode (skogix's call, 2026-10-09): the classifier decides,
# and anything it refuses shows up as "blocked" in `wo status`.
agent_args() {
  if [[ -n ${WO_ARGS+x} ]]; then read -ra ARGS <<<"$WO_ARGS"; return; fi
  case "$KIND" in
    claude) ARGS=(--permission-mode auto) ;;
    codex) ARGS=(--full-auto) ;;
    *) ARGS=() ;;
  esac
}

resolve() { # <id> -> NNNN-slug stem
  local m=("$WO_DIR"/"$1"*.md)
  [[ ${#m[@]} -eq 1 && -f ${m[0]} ]] || die "no unique workorder matching '$1'"
  basename "${m[0]}" .md
}

branch_of() { echo "wo/$1"; }
agent_of() { echo "wo-${1%%-*}"; }
wt_path() { wt -C "$1" list --format json | jq -r --arg b "$2" '.items[] | select(.branch == $b) | .worktree.path // empty'; }
path_of() { wt_path "$ROOT" "$(branch_of "$1")"; }
repo_root() { # target repo root for a workorder; empty when it targets skogai itself
  local r
  r=$(sed -n 's/^repo: *//p' "$WO_DIR/$1.md" | head -1)
  [[ -z $r || $r == skogai ]] && return 0
  gita ls "$r" 2>/dev/null || die "repo '$r' is not tracked by gita"
}
# Workers update their workorder on their own branch, so prefer the worktree's copy.
field() {
  local f="$WO_DIR/$1.md" wtp
  wtp=$(path_of "$1")
  [[ -n $wtp && -f $wtp/.skogai/workorders/$1.md ]] && f=$wtp/.skogai/workorders/$1.md
  sed -n "s/^$2: *//p" "$f" | head -1
}

workers_ws() {
  local ws
  ws=$(herdr workspace list | jq -r --arg l "$WORKERS_LABEL" '.result.workspaces[] | select(.label == $l) | .workspace_id' | head -1)
  if [[ -z $ws ]]; then
    ws=$(herdr workspace create --cwd "$ROOT" --label "$WORKERS_LABEL" --no-focus | jq -r '.result.workspace.workspace_id')
  fi
  echo "$ws"
}

cmd_new() {
  local slug=${1:?slug required}
  [[ $slug =~ ^[a-z0-9-]+$ ]] || die "slug must be [a-z0-9-]"
  local last n stem
  last=$(find "$WO_DIR" -maxdepth 1 -name '[0-9][0-9][0-9][0-9]-*.md' -printf '%f\n' | sort | tail -1)
  last=${last:0:4}
  n=$(printf '%04d' $((10#${last:-0} + 1)))
  stem="$n-$slug"
  sed -e "s/{{id}}/$stem/g" -e "s/{{date}}/$(date -u +%FT%TZ)/" "$WO_DIR/TEMPLATE.md" >"$WO_DIR/$stem.md"
  echo "$WO_DIR/$stem.md"
}

cmd_dispatch() {
  local stem branch agent path target cwd ws tab pane dir
  stem=$(resolve "${1:?id required}")
  branch=$(branch_of "$stem"); agent=$(agent_of "$stem")
  [[ $(field "$stem" status) == "open" ]] || die "$stem is not status: open"
  target=$(repo_root "$stem")

  # The worker's branch must contain the workorder, so it lands on master first.
  git -C "$ROOT" add "$WO_DIR/$stem.md"
  git -C "$ROOT" diff --cached --quiet -- "$WO_DIR/$stem.md" ||
    git -C "$ROOT" commit -q -m "Add workorder $stem" -- "$WO_DIR/$stem.md"

  wt -C "$ROOT" switch --create "$branch" --base master --no-cd --yes >/dev/null
  path=$(path_of "$stem")
  [[ -n $path ]] || die "worktree for $branch not found"
  cwd=$path

  agent_args
  if [[ -n $target ]]; then
    wt -C "$target" switch --create "$branch" --no-cd --yes >/dev/null
    cwd=$(wt_path "$target" "$branch")
    [[ -n $cwd ]] || die "worktree for $branch in $target not found"
    ARGS+=(--add-dir "$path")
  fi
  # `add_dir: <path>` in the workorder grants the worker access to a directory outside its worktree.
  while read -r dir; do
    [[ -n $dir ]] && ARGS+=(--add-dir "${dir/#\~/$HOME}")
  done < <(sed -n 's/^add_dir: *//p' "$WO_DIR/$stem.md")
  # `model: <id>` in the workorder picks the worker's model.
  local model
  model=$(sed -n 's/^model: *//p' "$WO_DIR/$stem.md" | head -1)
  [[ -n $model ]] && ARGS+=(--model "$model")

  ws=$(workers_ws)
  read -r tab pane < <(herdr tab create --workspace "$ws" --cwd "$cwd" --label "$agent" --no-focus |
    jq -r '"\(.result.tab.tab_id) \(.result.root_pane.pane_id)"')
  herdr agent start "$agent" --kind "$KIND" --pane "$pane" --timeout 60000 -- "${ARGS[@]}" >/dev/null
  herdr agent prompt "$agent" "$(worker_prompt "$stem" "$path" "$cwd")" >/dev/null
  echo "dispatched $stem → agent $agent, tab $tab, worktree $cwd"
}

worker_prompt() { # <stem> <skogai worktree> <worker cwd>
  local wo=".skogai/workorders/$1.md" where="this worktree (your current directory)"
  if [[ $2 != "$3" ]]; then
    wo="$2/.skogai/workorders/$1.md"
    where="this worktree (your current directory) for the work itself, and the skogai worktree $2 only for the workorder file"
  fi
  cat <<EOF
You are a skogai worker. Your workorder is $wo — read it first and do exactly what it asks, nothing outside its scope.
Rules: work only in $where, editing files by paths inside them — never in $ROOT, the target repo's main checkout, or any other checkout; commit your work on the current branch as you go (in each worktree you changed); do not merge, push, rebase or touch other worktrees.
When finished: append a "## Report" section to the workorder (what you did, anything left open, anything the orchestrator should know), set "status: done" in its frontmatter (or "status: blocked" with the reason if you cannot finish), and commit it. Then stop.
EOF
}

cmd_status() {
  local f stem
  printf '%-32s %-8s %-8s %s\n' WORKORDER STATUS AGENT WORKTREE
  for f in "$WO_DIR"/[0-9][0-9][0-9][0-9]-*.md; do
    [[ -f $f ]] || continue
    stem=$(basename "$f" .md)
    printf '%-32s %-8s %-8s %s\n' "$stem" "$(field "$stem" status)" \
      "$(herdr agent get "$(agent_of "$stem")" 2>/dev/null | jq -r '.result.agent.agent_status' || echo -)" \
      "$(path_of "$stem")"
  done
}

# A change only counts once it reaches origin (decision 0006), but only origins we own:
# never push to a fork's upstream or anyone else's repo.
PUSH_OWNERS='skogai2|skogix'
default_branch() { # <repo root>
  local b
  b=$(git -C "$1" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null) || b=origin/master
  echo "${b#origin/}"
}
check_origin() { # <repo root>: ours, and local default branch not behind origin
  local root=$1 url branch
  url=$(git -C "$root" remote get-url --push origin)
  [[ ${url,,} =~ github\.com[:/]($PUSH_OWNERS)/ ]] || die "$root: origin $url is not ours; not landing"
  branch=$(default_branch "$root")
  git -C "$root" fetch -q origin "$branch"
  git -C "$root" merge-base --is-ancestor "origin/$branch" "$branch" ||
    die "$root: $branch is behind or diverged from origin/$branch; reconcile before landing"
}
push_origin() { git -C "$1" push -q origin "$(default_branch "$1")"; }

cmd_land() {
  local stem branch agent path target tpath status tab
  stem=$(resolve "${1:?id required}")
  branch=$(branch_of "$stem"); agent=$(agent_of "$stem")
  path=$(path_of "$stem")
  [[ -n $path ]] || die "no worktree for $branch"
  status=$(sed -n 's/^status: *//p' "$path/.skogai/workorders/$stem.md" | head -1)
  [[ $status == "done" ]] || die "$stem is '$status' on its branch, not done"
  target=$(repo_root "$stem")
  [[ -n $target ]] && check_origin "$target"
  check_origin "$ROOT"

  # Target repo first: if its merge fails, the workorder stays unlanded too.
  if [[ -n $target ]]; then
    tpath=$(wt_path "$target" "$branch")
    [[ -n $tpath ]] || die "no worktree for $branch in $target"
    wt -C "$tpath" merge --yes --no-remove
  fi
  wt -C "$path" merge master --yes --no-remove
  tab=$(herdr agent get "$agent" 2>/dev/null | jq -r '.result.agent.tab_id // empty') || true
  [[ -n $tab ]] && herdr tab close "$tab" >/dev/null
  [[ -n $target ]] && wt -C "$target" remove "$branch" --yes
  wt -C "$ROOT" remove "$branch" --yes
  [[ -n $target ]] && push_origin "$target"
  push_origin "$ROOT"
  echo "landed $stem (pushed)"
}

case "${1:-}" in
  new) shift; cmd_new "$@" ;;
  dispatch) shift; cmd_dispatch "$@" ;;
  status) cmd_status ;;
  land) shift; cmd_land "$@" ;;
  *) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
