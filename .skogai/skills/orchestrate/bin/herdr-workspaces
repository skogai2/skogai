#!/usr/bin/env bash
set -euo pipefail

workspaces=(
  "orchestration|$HOME"
  "skogai-config|$HOME/.config/skogai"
  "skogai|$HOME/skogai"
  "skogai-runner|$HOME/skogai-runner"
)

die() { echo "herdr-workspaces: $*" >&2; exit 1; }

dry_run=0
case "${1:-}" in
  "") ;;
  --dry-run) dry_run=1 ;;
  *) die "usage: herdr-workspaces [--dry-run]" ;;
esac

[[ "${HERDR_ENV:-}" == 1 ]] || die "not inside herdr (HERDR_ENV != 1)"
command -v herdr >/dev/null || die "herdr not found"
command -v jq >/dev/null || die "jq not found"

existing=$(herdr workspace list | jq -r '.result.workspaces[].label')

for entry in "${workspaces[@]}"; do
  label=${entry%%|*}
  cwd=${entry#*|}
  grep -qxF "$label" <<<"$existing" && continue
  [[ -d "$cwd" ]] || { echo "skip $label: $cwd does not exist" >&2; continue; }
  if ((dry_run)); then
    echo "would create $label  $cwd"
  else
    herdr workspace create --label "$label" --cwd "$cwd" --no-focus |
      jq -r --arg label "$label" '.result.workspace.workspace_id + "  " + $label'
  fi
done
