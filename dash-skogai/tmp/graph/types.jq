def name: .file | split("/") | last | rtrimstr(".md");
def esc: gsub("<"; "#lt;") | gsub(">"; "#gt;") | gsub("\""; "#quot;");
def list: if . == null or . == [] then "" else map("`" + . + "`") | join(", ") end;

(map(select(.file | test("^type/[^/]+\\.md$"))) | map(. + {name: name})) as $types
| (map(select(.file | test("^type/[^/]+/[^/]+\\.md$"))) | map(. + {name: name, parent: (.file | split("/")[1])})) as $instances
| ($instances | to_entries | map(.value + {id: "i\(.key)"})) as $instances
| ([$types[] | (.owns // []), (.writes // []), (.watches // []) | .[]] | unique) as $paths
| ($paths | to_entries | map({key: .value, value: "p\(.key)"}) | from_entries) as $pid
| def edges($rel; $arrow):
    $types[] | . as $t | (.[$rel] // [])[] | "  t_\($t.name) \($arrow) \($pid[.])";
[
  "<!-- generated by tmp/graph/types.sh from type/*.md at \($rev). do not edit. -->",
  "# types",
  "",
  "```mermaid",
  "flowchart LR",
  "  classDef type fill:#dbeafe,stroke:#1d4ed8,color:#0b1b3a",
  "  classDef draft fill:#fef3c7,stroke:#b45309,color:#3a2604",
  "  classDef stub fill:#f3f4f6,stroke:#9ca3af,color:#6b7280,stroke-dasharray:4 3",
  "  classDef inst fill:#dcfce7,stroke:#15803d,color:#052e16",
  "  classDef path fill:#ffffff,stroke:#6b7280,color:#111827",
  "",
  ($types[] | "  t_\(.name)([\"\(.name)\"]):::\(if .type != "type" then "stub" elif .status == "draft" then "draft" else "type" end)"),
  ($pid | to_entries[] | "  \(.value)[\"\(.key | esc)\"]:::path"),
  "",
  edges("owns"; "-->|owns|"),
  edges("writes"; "-.->|writes|"),
  edges("watches"; "==>|watches|"),
  ($instances[] | "  \(.id)[\"\(.name | esc)\"]:::inst", "  t_\(.parent) --- \(.id)"),
  "```",
  "",
  "blue: type. yellow: draft. grey dashed: stub with no frontmatter. green: instance. solid: owns, dashed: writes, thick: watches.",
  "every type is also an instance of `type`; those edges are left out.",
  "",
  "| type | fields | owns | writes | watches | instances |",
  "|---|---|---|---|---|---|",
  ($types[] | . as $t
    | "| [\(.name)](../../\(.file)) | \(.fields | list) | \(.owns | list) | \(.writes | list) | \(.watches | list) | \([$instances[] | select(.parent == $t.name) | .name] | join(", ")) |"),
  ""
] | .[]
