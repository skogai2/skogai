def esc: gsub("<"; "#lt;") | gsub(">"; "#gt;") | gsub("\""; "#quot;");
def code: "`" + . + "`";
def links: gsub("\\]\\((?<p>[^)#:]+)\\)"; "](type/\(.p))");
def demote: gsub("(?m)^#"; "##");
def graph:
    . as $t
    | [(.owns // [] | map({rel: "-->|owns|", p: .})), (.writes // [] | map({rel: "-.->|writes|", p: .})), (.watches // [] | map({rel: "==>|watches|", p: .}))]
    | add
    | if length == 0 then empty else
        "```mermaid", "flowchart LR",
        "  t([\"\($t.name)\"])",
        (to_entries[] | "  t \(.value.rel) p\(.key)[\"\(.value.p | esc)\"]"),
        "```", ""
      end;
def section:
    "## \(.name)", "",
    (if .type != "type" then "_stub: no definition yet._", ""
     else
        (if .status then "**status:** \(.status)", "" else empty end),
        (.description // empty | ., ""),
        graph,
        "- **fields:** \(.fields // [] | map(code) | join(", "))",
        (if .owns then "- **owns:** \(.owns | map(code) | join(", "))" else empty end),
        (if .writes then "- **writes:** \(.writes | map(code) | join(", "))" else empty end),
        (if .watches then "- **watches:** \(.watches | map(code) | join(", "))" else empty end),
        (if (.instances | length) > 0 then "- **instances:** \(.instances | map("[\(.title)](\(.file))") | join(", "))" else empty end),
        "",
        (.body | sub("^\\s*# [^\n]*\n"; "") | links | demote | sub("^\\s+"; "") | sub("\\s+$"; "")),
        ""
     end);
"<!-- generated by tmp/graph/types.sh from type/*.md at \($rev). do not edit: change type/*.md and run mise run dash:graph. -->",
"# dash-skogai types",
"",
"one section per type, in [type/index.md](type/index.md) order. each type says which files every instance of it **owns** (creates and manages, exactly one owner), **writes** (modifies without owning) and **watches** (reads, wants to know about changes). `<name>` in a path is the instance's name.",
"",
(.[] | section)
