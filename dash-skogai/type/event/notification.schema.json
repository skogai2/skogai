{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event.notification",
  "title": "Notification",
  "allOf": [
    {
      "$ref": "event#/$defs/row"
    }
  ],
  "properties": {
    "event": {
      "const": "Notification"
    },
    "input": {
      "allOf": [
        {
          "$ref": "event#/$defs/input"
        }
      ],
      "required": [
        "message"
      ],
      "properties": {
        "message": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "notification_type": {
          "type": "string"
        }
      }
    }
  }
}
