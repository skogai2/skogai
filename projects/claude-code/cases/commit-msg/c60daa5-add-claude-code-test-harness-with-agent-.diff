+++ b/projects/claude-code/README.md
@@ -0,0 +1,29 @@
+# claude-code test environment
+
+Start from a Claude Code agent with everything stripped, then add one feature at a time and prove it with a test.
+
+Each run happens in a throwaway sandbox at `/tmp/claude-code/$SETUP/`:
+
+- `config/` is `CLAUDE_CONFIG_DIR`: transcripts (`projects/*/*.jsonl`), `.claude.json`, settings, and any other state the run creates. `.credentials.json` is a symlink to `~/.claude`.
+- `work/` is the working directory.
+
+The sandbox is wiped at the start of every run (`KEEP=1` reuses it), so what's in it afterwards came from that run only.
+
+## Setups
+
+A setup is `setups/<name>/` containing:
+
+- `settings.json`: copied into the sandbox as its user settings.
+- `system-prompt.md`: replaces the default system prompt.
+- `work/`: optional. Copied into the working dir (for CLAUDE.md, `.claude/`, fixtures).
+
+## Commands
+
+- `bin/agent`: a one-shot agent. The prompt comes on stdin. Env vars: `SETUP` (baseline), `MODEL` (haiku), `TOOLS` (none), `OUTPUT` (text), `KEEP`. Extra args are passed to `claude`.
+- `bin/inspect`: prints the session surface and the context size of a trivial turn.
+- `bin/transcript`: prints the path of the latest transcript in the sandbox.
+- `tests/run`: runs `tests/NN-*.sh`.
+
+Note: `CLAUDE_CONFIG_DIR` only takes effect from the process environment. Putting it under `env` in settings.json does nothing, because settings are read from the config dir.
+
+Reference docs: `../../tmp/claude-docs/` (`settings.md`, `env-vars.md`, `cli-reference.md`, `claude-directory.md`).
diff --git a/projects/claude-code/bin/agent b/projects/claude-code/bin/agent
new file mode 100755
index 0000000..e529511
--- /dev/null
+++ b/projects/claude-code/bin/agent
@@ -0,0 +1,51 @@
+#!/usr/bin/env bash
+# Run a one-shot Claude Code agent in a fully isolated sandbox:
+#   /tmp/claude-code/$SETUP/config  CLAUDE_CONFIG_DIR (transcripts, state, settings)
+#   /tmp/claude-code/$SETUP/work    working directory
+# The sandbox is wiped at the start of each run (KEEP=1 to reuse it), so
+# everything in it afterwards was produced by this run.
+#
+#   echo "say pong" | bin/agent
+#   echo "list files" | SETUP=tools TOOLS=Bash bin/agent
+#
+# Setup files come from setups/$SETUP/:
+#   settings.json     -> config/settings.json (user scope inside the sandbox)
+#   system-prompt.md  -> --system-prompt-file
+#   work/             -> copied into work/ (optional; e.g. CLAUDE.md, .claude/)
+set -euo pipefail
+root=$(cd "$(dirname "$0")/.." && pwd)
+
+: "${SETUP:=baseline}"
+: "${MODEL:=haiku}"
+: "${TOOLS:=}"
+: "${OUTPUT:=text}"
+: "${SANDBOX_ROOT:=/tmp/claude-code}"
+export MAX_THINKING_TOKENS="${MAX_THINKING_TOKENS:-0}"
+
+setup="$root/setups/$SETUP"
+[[ -d $setup ]] || { echo "no such setup: $setup" >&2; exit 1; }
+box="$SANDBOX_ROOT/$SETUP"
+
+if [[ ${KEEP:-0} != 1 || ! -d $box ]]; then
+  rm -rf "$box"
+  mkdir -p "$box/config" "$box/work"
+  ln -s "$HOME/.claude/.credentials.json" "$box/config/.credentials.json"
+  [[ -f $setup/settings.json ]] && cp "$setup/settings.json" "$box/config/settings.json"
+  [[ -d $setup/work ]] && cp -a "$setup/work/." "$box/work/"
+fi
+
+export CLAUDE_CONFIG_DIR="$box/config"
+cd "$box/work"
+
+args=(
+  -p
+  --model "$MODEL"
+  --tools "$TOOLS"
+  --strict-mcp-config
+  --disable-slash-commands
+  --output-format "$OUTPUT"
+)
+[[ -f $setup/system-prompt.md ]] && args+=(--system-prompt-file "$setup/system-prompt.md")
+[[ $OUTPUT == stream-json ]] && args+=(--verbose)
+
+exec claude "${args[@]}" "$@"
diff --git a/projects/claude-code/bin/inspect b/projects/claude-code/bin/inspect
new file mode 100755
index 0000000..4242ed2
--- /dev/null
+++ b/projects/claude-code/bin/inspect
@@ -0,0 +1,12 @@
+#!/usr/bin/env bash
+# Print what an agent session exposes (tools, skills, agents, plugins, mcp)
+# plus the token cost of a trivial turn. Same env/args as bin/agent.
+set -euo pipefail
+cd "$(dirname "$0")/.."
+echo "reply with: ok" | OUTPUT=stream-json bin/agent "$@" | jq -c '
+  if .type == "system" and .subtype == "init" then
+    {tools, skills, agents, mcp_servers, plugins: [.plugins[].name], slash_commands}
+  elif .type == "result" then
+    {result, cost_usd: .total_cost_usd,
+     context_tokens: (.usage.input_tokens + .usage.cache_creation_input_tokens + .usage.cache_read_input_tokens)}
+  else empty end'
