diff --git a/projects/claude-code/tests/00-surface.sh b/projects/claude-code/tests/00-surface.sh
new file mode 100644
index 0000000..2c8c148
--- /dev/null
+++ b/projects/claude-code/tests/00-surface.sh
@@ -0,0 +1,7 @@
+# Baseline: the agent exposes nothing beyond the model itself.
+set -euo pipefail
+init=$(echo "reply with: ok" | OUTPUT=stream-json bin/agent | jq -c 'select(.type=="system" and .subtype=="init")')
+for key in tools skills mcp_servers plugins slash_commands; do
+  n=$(jq ".$key | length" <<<"$init")
+  [[ $n -eq 0 ]] || { echo "$key not empty: $(jq -c ".$key" <<<"$init")"; exit 1; }
+done
diff --git a/projects/claude-code/tests/01-roundtrip.sh b/projects/claude-code/tests/01-roundtrip.sh
new file mode 100644
index 0000000..2845e1f
--- /dev/null
+++ b/projects/claude-code/tests/01-roundtrip.sh
@@ -0,0 +1,4 @@
+# The model answers and follows the system prompt.
+set -euo pipefail
+out=$(echo "Reply with exactly the word pong and nothing else." | bin/agent)
+[[ ${out,,} == *pong* ]] || { echo "got: $out"; exit 1; }
diff --git a/projects/claude-code/tests/02-transcript.sh b/projects/claude-code/tests/02-transcript.sh
new file mode 100644
index 0000000..694ac09
--- /dev/null
+++ b/projects/claude-code/tests/02-transcript.sh
@@ -0,0 +1,7 @@
+# The run writes a real transcript into the sandbox config dir.
+set -euo pipefail
+echo "Reply with exactly the word pong." | bin/agent >/dev/null
+t=$(bin/transcript)
+[[ -n $t ]] || { echo "no transcript in /tmp/claude-code/baseline/config/projects"; exit 1; }
+jq -e 'select(.type=="assistant") | .message.content[] | select(.type=="text") | .text | ascii_downcase | contains("pong")' "$t" >/dev/null \
+  || { echo "assistant reply missing from $t"; exit 1; }
diff --git a/projects/claude-code/tests/run b/projects/claude-code/tests/run
new file mode 100755
index 0000000..0948783
--- /dev/null
+++ b/projects/claude-code/tests/run
@@ -0,0 +1,13 @@
+#!/usr/bin/env bash
+# Run every tests/NN-*.sh; each exits non-zero on failure.
+cd "$(dirname "$0")/.."
+pass=0 fail=0
+for t in tests/[0-9]*.sh; do
+  if out=$(bash "$t" 2>&1); then
+    echo "PASS $t"; pass=$((pass+1))
+  else
+    echo "FAIL $t"; echo "$out" | sed 's/^/  /'; fail=$((fail+1))
+  fi
+done
+echo "$pass passed, $fail failed"
+[[ $fail -eq 0 ]]
