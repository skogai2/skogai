#!/usr/bin/env bash
# Show how responses differ between two runs (default: the two newest).
#   bin/compare commit-msg
#   bin/compare runs/commit-msg/<a> runs/commit-msg/<b>
set -euo pipefail
cd "$(dirname "$0")/.."
if [[ $# -eq 1 ]]; then
  mapfile -t r < <(ls -d runs/"$1"/2* | tail -2)
  [[ ${#r[@]} -eq 2 ]] || { echo "need two runs in runs/$1" >&2; exit 1; }
  set -- "${r[@]}"
fi
for o in "$2"/*.out; do
  n=$(basename "$o")
  printf '\n━━━ %s ━━━\n' "${n%.out}"
  diff --color=auto -u "$1/$n" "$o" | tail -n +3 || true
done
