#!/usr/bin/env bash
# Show every response in a run, one after another.
#   bin/review commit-msg              # latest run
#   bin/review runs/commit-msg/<stamp>
#   bin/review commit-msg | less
set -euo pipefail
cd "$(dirname "$0")/.."
dir=$1; [[ -d $dir ]] || dir="runs/$1/latest"
cat "$dir/meta.txt"
for o in "$dir"/*.out; do
  printf '\n━━━ %s ━━━\n' "$(basename "${o%.out}")"
  cat "$o"
done
