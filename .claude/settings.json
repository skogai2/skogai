{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "atuin hook claude-code"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "concord hook pre-tool-use"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/skogix/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "concord hook session-start"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "atuin hook claude-code"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "atuin hook claude-code"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/home/skogix/.claude/hooks/worktree-create.sh\"",
            "timeout": 180
          }
        ]
      }
    ]
  },
  "syncClaudeAiSkills": false,
  "env": {
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
    "CLAUDE_CODE_DISABLE_POLICY_SKILLS": "1",
    "CLAUDE_CODE_DISABLE_OFFICIAL_MARKETPLACE_AUTOINSTALL": "1"
  },
  "permissions": {
    "allow": [
      "Bash(gita *)",
      "Bash(git *)",
      "Bash(okn *)",
      "Bash(herdr *)",
      "Bash(wt *)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "wt list statusline --format=claude-code"
  },
  "enabledPlugins": {
    "nelson@synced": false,
    "cc-plugin-you-should-know@builtin": false,
    "cc-plugin-diff@builtin": false,
    "cc-plugin-telemetry@builtin": false
  },
  "extraKnownMarketplaces": {
    "skogai-marketplace": {
      "source": {
        "source": "git",
        "url": "https://github.com/skogai2/marketplace.git"
      },
      "autoUpdate": true
    }
  },
  "outputStyle": "Concise",
  "feedbackDrafts": "notify",
  "dialogExpiry": "never",
  "pluginConfigs": {
    "cc-plugin-agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-or-agents-md"
      }
    }
  },
  "timeFormat": "24-hour",
  "autoMemoryEnabled": false,
  "autoMemoryDirectory": "/home/skogix/claude/.skogai/memory",
  "theme": "dark-daltonized",
  "editorMode": "vim",
  "preferredNotifChannel": "auto",
  "switchModelsOnFlag": true,
  "remoteControlAtStartup": true,
  "crossSessionInbound": "accept",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
