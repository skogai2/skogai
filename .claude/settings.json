{
  "syncClaudeAiSkills": false,
  "env": {
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
    "CLAUDE_CODE_DISABLE_POLICY_SKILLS": "1",
    "CLAUDE_CODE_DISABLE_OFFICIAL_MARKETPLACE_AUTOINSTALL": "1"
  },
  "model": "opus",
  "hooks": {
    "PostToolUse": [],
    "PostToolUseFailure": [],
    "PreToolUse": [],
    "SessionStart": [],
    "WorktreeCreate": []
  },
  "statusLine": {
    "type": "command",
    "command": "wt list statusline --format=claude-code"
  },
  "enabledPlugins": {
    "nelson@synced": false,
    "worktrunk@worktrunk": false,
    "cc-plugin-you-should-know@builtin": false,
    "cc-plugin-diff@builtin": false,
    "cc-plugin-telemetry@builtin": false
  },
  "extraKnownMarketplaces": {
    "worktrunk": {
      "source": {
        "source": "github",
        "repo": "max-sixty/worktrunk"
      },
      "autoUpdate": true
    },
    "skogai-marketplace": {
      "source": {
        "source": "git",
        "url": "https://github.com/skogai2/marketplace.git"
      },
      "autoUpdate": true
    },
    "openai-codex": {
      "source": {
        "source": "git",
        "url": "https://github.com/openai/codex-plugin-cc.git"
      }
    }
  },
  "outputStyle": "Concise",
  "feedbackDrafts": "notify",
  "dialogExpiry": "never",
  "pluginConfigs": {
    "cc-plugin-agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-or-agents-md"
      }
    }
  },
  "timeFormat": "24-hour",
  "autoMemoryEnabled": false,
  "autoMemoryDirectory": "/home/skogix/claude/.skogai/memory",
  "theme": "dark-daltonized",
  "editorMode": "vim",
  "preferredNotifChannel": "auto",
  "switchModelsOnFlag": true,
  "remoteControlAtStartup": true,
  "crossSessionInbound": "accept",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(gita *)",
      "Bash(git *)",
      "Bash(okn *)",
      "Bash(herdr *)",
      "Bash(wt *)"
    ]
  }
}
